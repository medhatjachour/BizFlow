# Example environment variables
# Copy this to .env.local (development) or .env.production (VPS)

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=production

# ============================================================================
# DATABASE
# ============================================================================
# Local database file (Docker volume: /data/bizflow)
DATABASE_URL=file:/data/bizflow/database.db

# ============================================================================
# BRIDGE SERVER (HTTP Bridge for IPC handlers)
# ============================================================================
BRIDGE_PORT=8787
BRIDGE_MAX_SESSIONS=50
BRIDGE_SESSION_TTL_MS=1800000

# ============================================================================
# NEXT.JS / NEBULA WEBSITE
# ============================================================================
# Full URL where app is accessible (used for auth redirects, cookies)
NEXTAUTH_URL=https://yourdomain.com

# Secret key for encrypting auth tokens (generate: `openssl rand -base64 32`)
NEXTAUTH_SECRET=your-random-secret-key-here

# API base URL for client-side requests
NEXT_PUBLIC_API_URL=https://yourdomain.com/ipc

# ============================================================================
# EMAIL / SMTP (Optional - for sending reports, invoices, etc)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ============================================================================
# STRIPE (Optional - if using Nebula payment features)
# ============================================================================
NEXT_PUBLIC_STRIPE_KEY=pk_live_your_stripe_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret

# ============================================================================
# LOGGING (Optional - for monitoring)
# ============================================================================
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# ============================================================================
# DEVELOPMENT ONLY (NOT for production)
# ============================================================================
DEBUG=bizflow:*
ENABLE_DEV_TOOLS=false
