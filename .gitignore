# Root monorepo ignores (each app also has its own .gitignore)

# Local test / smoke-test artifacts
live-plugin-*.html
portal-*.html
portal-*.json
portal-*.txt
portal-*.js
portal-seed.js
portal-check.js
admin-cookie.txt
admin-login-body.json
node_modules/
*.log
.DS_Store
node_modules
dist
out
.DS_Store
.eslintcache
*.log*

# /web?
apps/Bizflow/web/.dist-web/
apps/Bizflow/web/.dist/
# Prisma generated client
/src/generated/prisma
/out/generated/prisma
# Auto-generated merged schema (rebuilt by scripts/merge-schemas.js)
prisma/merged.prisma

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm
prisma/*.db
prisma/*.db-*
prisma/*.db-journal
prisma/seeds/clinic-dentist/*
prisma/seeds/vet/generated-check-results/*
# Prisma images (product images)
prisma/images/
prisma/clinic-results/
/*.db-journal

# coverage unit  test
coverage/
.nyc_output/
*.lcov
coverage-reports/

# Build-time plugin configuration (generated by npm run build:configure)
.env.build
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local request submissions store
.data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─────────────────────────────────────────────────────────────────────────────
# Project-specific ignores
# ─────────────────────────────────────────────────────────────────────────────

# Local editor / AI-assistant configuration (machine-specific, not project config)
.continue/

# Root-domain static site. It is built from the SEPARATE portfolio repository and
# deployed out-of-band to the host, so the build output must never be committed
# here. See docs/PRODUCTION_SERVER_RUNBOOK.md section 15.
portfolio-dist/

# Scratch scripts written during deploys/debugging (e.g. .tmp-dbcheck.sh)
.tmp-*

# Host marker: its presence makes scripts/reset-demo-data.sh refuse to run.
# Created on the production server, never committed.
.production

# Database backups produced by scripts/backup-data.sh
backups/

# Secrets: never commit a private key. `*.pem` is already ignored above; these are
# listed explicitly so the intent is unmistakable.
license-signing-private.pem
license-private.pem
*-private.pem
*.key

# ...but the desktop app's PUBLIC verification key must stay committed, because a
# packaged build falls back to this file when BIZFLOW_LICENSE_PUBLIC_KEY is unset.
!apps/Bizflow/resources/license-public.pem

# Keep env templates in the repo so new contributors can bootstrap.
!.env.example
!**/.env.example

# Performance-harness output (generated: raw samples, scaling charts, desktop bench report).
# The harness itself lives in scripts/perf/ and is committed; only its results are ignored.
perf-reports/
