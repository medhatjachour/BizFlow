generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "windows", "darwin-arm64", "darwin", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// COFFEE PLUGIN SCHEMA
// ─────────────────────────────────────────────────────────────────────────────
// Auto-generated via: node scripts/merge-schemas.js
// Do not edit manually — this is a placeholder. The build process uses merged.prisma
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                      String                 @id @default(uuid())
  username                String                 @unique
  passwordHash            String
  role                    String                 @default("sales") // admin, manager, sales, inventory, finance
  pluginRoles             String                 @default("{}") // JSON map: plugin id -> plugin role key
  fullName                String?                // Full display name
  email                   String?                @unique
  phone                   String?
  isActive                Boolean                @default(true) // Can disable users without deleting
  lastLogin               DateTime?              // Track last login time
  deactivatedAt           DateTime?              // When user was deactivated
  deactivatedBy           String?                // User ID who deactivated this user
  deactivatedByUser       User?                  @relation("UserDeactivations", fields: [deactivatedBy], references: [id], onDelete: SetNull)
  deactivatedUsers        User[]                 @relation("UserDeactivations") // Users this user has deactivated
  financialTransactions   FinancialTransaction[] // Financial records
  emailReports            EmailReport[]          // Email report subscriptions
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  
  @@index([role])
  @@index([createdAt])
  @@index([username])
  @@index([isActive])
  @@index([deactivatedBy])
}

// Role-based permissions — capability overrides per role (JSON array of keys).
// Absent row = use built-in defaults from src/shared/permissions.ts.
model RolePermission {
  role         String   @id           // 'admin' | 'manager' | 'sales' | 'cashier' | custom
  capabilities String   @default("[]") // JSON-encoded Capability[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Financial Transaction (renamed from Transaction to avoid confusion)
model FinancialTransaction {
  id          String   @id @default(uuid())
  type        String   // "income" or "expense"
  amount      Float
  description String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Employee {
  id              String              @id @default(uuid())
  // Core identity
  name            String
  role            String              // e.g. "Cashier", "Manager", "Warehouse"
  department      String?             // e.g. "Sales", "Operations"
  email           String?             @unique
  phone           String
  address         String?
  nationalId      String?             // National ID / passport number
  avatarUrl       String?             // Profile photo path
  // Employment details
  employmentType  String              @default("full-time") // full-time, part-time, contract
  status          String              @default("active")    // active, on-leave, terminated
  hireDate        DateTime            @default(now())
  terminationDate DateTime?
  terminationNote String?
  // Compensation
  salary          Float               @default(0)
  salaryType      String              @default("monthly")   // monthly, hourly, daily
  // Emergency contact
  emergencyName   String?
  emergencyPhone  String?
  // Notes
  notes           String?
  // Performance
  performanceScore Float?              // 0–100 performance score
  // Leave
  annualLeaveDays Int                 @default(21) // yearly paid-leave allowance
  // Payout & compliance
  taxId             String?           // tax file / TIN
  socialInsuranceNo String?           // social insurance / social security number
  bankName          String?
  iban              String?           // bank account / IBAN for salary transfer
  // Contract & documents lifecycle
  contractEndDate   DateTime?         // fixed-term contract end / renewal date
  idExpiryDate      DateTime?         // national ID / visa / work-permit expiry
  // Org chart — self-relation (who this employee reports to)
  managerId       String?
  manager         Employee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports         Employee[]          @relation("EmployeeManager")
  // Relations
  attendance      EmployeeAttendance[]
  documents       EmployeeDocument[]
  activityLogs    EmployeeActivityLog[]
  payrollRecords  EmployeePayroll[]
  shifts          EmployeeShift[]
  overtimeRecords EmployeeOvertime[]
  leaveRecords    EmployeeLeave[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([name])
  @@index([role])
  @@index([status])
  @@index([department])
  @@index([hireDate])
  @@index([email])
  @@index([managerId])
}

// Daily check-in / check-out attendance
model EmployeeAttendance {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime // The calendar day (midnight UTC)
  checkIn    DateTime?
  checkOut   DateTime?
  status     String   @default("present") // present, absent, late, half-day, leave
  notes      String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

// Files / contracts / certificates attached to employee
model EmployeeDocument {
  id          String   @id @default(uuid())
  employeeId  String
  title       String
  type        String   // contract, id_copy, certificate, other
  filename    String
  uploadedAt  DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([type])
}

// Audit log: every significant action tied to an employee
model EmployeeActivityLog {
  id          String   @id @default(uuid())
  employeeId  String
  action      String   // e.g. "salary_updated", "status_changed", "checked_in"
  details     String?  // JSON or plain text description
  performedBy String?  // userId who performed the action
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([createdAt])
  @@index([action])
}

// Monthly payroll records
model EmployeePayroll {
  id              String   @id @default(uuid())
  employeeId      String
  month           Int      // 1–12
  year            Int
  baseSalary      Float
  regularHours    Float    @default(0)   // standard hours worked this period
  overtimeHours   Float    @default(0)   // extra hours beyond normal shift
  overtimePay     Float    @default(0)   // auto-computed: overtimeHours × hourlyRate × multiplier
  extraShifts     Int      @default(0)   // number of extra/double shifts covered
  extraShiftPay   Float    @default(0)   // flat bonus per extra shift
  bonuses         Float    @default(0)
  deductions      Float    @default(0)
  grossPay        Float    @default(0)   // baseSalary + overtimePay + extraShiftPay + bonuses
  netPay          Float
  status          String   @default("pending") // pending, paid
  paidDate        DateTime?
  notes           String?
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
  @@index([status])
}

// Planned shifts — when an employee is scheduled to work
model EmployeeShift {
  id          String   @id @default(uuid())
  employeeId  String
  date        DateTime
  shiftType   String   @default("morning")  // morning, evening, night, custom
  startTime   String   // "HH:MM"
  endTime     String   // "HH:MM"
  breakMins   Int      @default(0)
  notes       String?
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([date])
}

// Overtime records — extra hours worked beyond the normal shift
model EmployeeOvertime {
  id          String   @id @default(uuid())
  employeeId  String
  date        DateTime
  hours       Float    // extra hours worked
  reason      String?
  approved    Boolean  @default(false)
  approvedBy  String?
  multiplier  Float    @default(1.5)  // pay rate multiplier (1.5 = time + half)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([date])
}

// Leave / PTO requests — annual, sick, unpaid, etc.
model EmployeeLeave {
  id          String   @id @default(uuid())
  employeeId  String
  type        String   @default("annual")   // annual, sick, unpaid, other
  startDate   DateTime
  endDate     DateTime
  days        Float                          // number of leave days (supports half-days)
  reason      String?
  status      String   @default("pending")  // pending, approved, rejected
  approvedBy  String?
  reviewedAt  DateTime?
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model EmailReport {
  id          String   @id @default(uuid())
  userId      String
  email       String
  frequency   String   @default("daily") // daily, weekly, monthly
  enabled     Boolean  @default(true)
  lastSent    DateTime?
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, enabled])
}
