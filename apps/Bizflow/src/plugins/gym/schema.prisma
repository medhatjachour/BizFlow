// ─── Gym Plugin Models ────────────────────────────────────────────────────────

model GymCoach {
  id            String           @id @default(uuid())
  name          String
  specialty     String?
  phone         String?
  email         String?
  nationalId    String?
  salary        Float            @default(0)
  salaryType    String           @default("monthly")
  hireDate      DateTime         @default(now())
  isActive      Boolean          @default(true)
  notes         String?
  subscriptions GymSubscription[]
  sessions      GymWalkSession[]
  programs      GymProgram[]
  shifts        GymShift[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([name])
  @@index([isActive])
}

model GymTrainee {
  id               String           @id @default(uuid())
  name             String
  phone            String?
  email            String?
  dateOfBirth      DateTime?
  gender           String?
  nationalId       String?
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  notes              String?
  subscriptions      GymSubscription[]
  sessions           GymWalkSession[]
  measurements       GymMeasurement[]
  goals              GymGoal[]
  programAssignments GymProgramAssignment[]
  lockerAssignments  GymLockerAssignment[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([name])
  @@index([phone])
  @@index([createdAt])
}

model GymPlan {
  id              String           @id @default(uuid())
  name            String
  description     String?

  // Category / Goal
  category        String           @default("general")
  // general | weight-loss | muscle-gain | athletic | wellness | vip

  // Duration & Pricing
  durationDays    Int
  price           Float
  maxFreezeDays   Int              @default(0)

  // Sessions
  sessionsPerWeek Int?             // null = unlimited
  sessionsTotal   Int?             // null = unlimited (derived from days)
  coachSessions   Int              @default(0) // personal-trainer sessions included

  // Amenities
  hasSauna        Boolean          @default(false)
  hasJacuzzi      Boolean          @default(false)
  hasPool         Boolean          @default(false)
  hasLocker       Boolean          @default(false)
  hasTowel        Boolean          @default(false)
  hasNutritionPlan Boolean         @default(false)
  hasBodyAnalysis Boolean          @default(false)
  hasFitnessTest  Boolean          @default(false)
  hasGroupClass   Boolean          @default(false)
  guestPasses     Int              @default(0)

  // Display
  color           String           @default("orange")
  // orange | blue | purple | emerald | teal | rose
  isPopular       Boolean          @default(false)
  features        String?          // free-text custom perks (comma-separated legacy)
  isActive        Boolean          @default(true)

  subscriptions   GymSubscription[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model GymSubscription {
  id             String           @id @default(uuid())
  traineeId      String
  trainee        GymTrainee       @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  planId         String
  plan           GymPlan          @relation(fields: [planId], references: [id])
  coachId        String?
  coach          GymCoach?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  startDate      DateTime
  endDate        DateTime
  status         String           @default("active")
  amountPaid     Float
  paymentMethod  String           @default("cash")
  freezeDaysUsed Int              @default(0)
  notes          String?
  freezes        GymFreeze[]
  sessions       GymWalkSession[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([traineeId])
  @@index([status])
  @@index([endDate])
}

model GymFreeze {
  id             String          @id @default(uuid())
  subscriptionId String
  subscription   GymSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  days           Int
  reason         String?
  createdAt      DateTime        @default(now())

  @@index([subscriptionId])
}

model GymWalkSession {
  id             String           @id @default(uuid())
  traineeId      String?
  trainee        GymTrainee?      @relation(fields: [traineeId], references: [id], onDelete: SetNull)
  coachId        String?
  coach          GymCoach?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   GymSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  date           DateTime         @default(now())
  type           String           @default("walkin")
  amount         Float            @default(0)
  paymentMethod  String?
  notes          String?
  createdAt      DateTime         @default(now())

  @@index([traineeId])
  @@index([date])
  @@index([type])
}

model GymExpense {
  id            String   @id @default(uuid())
  category      String
  amount        Float
  date          DateTime
  description   String
  vendor        String?
  paymentMethod String   @default("cash")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([date])
}

// ─── Feature: Body Measurements ───────────────────────────────────────────────
model GymMeasurement {
  id        String     @id @default(uuid())
  traineeId String
  trainee   GymTrainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  date      DateTime   @default(now())
  weight    Float?     // kg
  bodyFat   Float?     // %
  muscle    Float?     // kg
  waist     Float?     // cm
  chest     Float?     // cm
  arms      Float?     // cm
  legs      Float?     // cm
  notes     String?
  createdAt DateTime   @default(now())

  @@index([traineeId])
  @@index([date])
}

// ─── Feature: Goals ──────────────────────────────────────────────────────────
model GymGoal {
  id           String     @id @default(uuid())
  traineeId    String
  trainee      GymTrainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  title        String
  type         String     @default("custom")
  // weight | sessions | streak | measurement | custom
  targetValue  Float?
  currentValue Float?
  unit         String?
  deadline     DateTime?
  status       String     @default("active")
  // active | achieved | cancelled
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([traineeId])
  @@index([status])
}

// ─── Feature: Workout Programs ───────────────────────────────────────────────
model GymProgram {
  id          String                @id @default(uuid())
  name        String
  description String?
  goal        String                @default("general")
  weeksTotal  Int                   @default(4)
  daysPerWeek Int                   @default(3)
  coachId     String?
  coach       GymCoach?             @relation(fields: [coachId], references: [id], onDelete: SetNull)
  isActive    Boolean               @default(true)
  days        GymProgramDay[]
  assignments GymProgramAssignment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([coachId])
}

model GymProgramDay {
  id         String               @id @default(uuid())
  programId  String
  program    GymProgram           @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNumber Int                  @default(1)
  dayNumber  Int                  @default(1)
  name       String               @default("Day")
  exercises  GymProgramExercise[]

  @@index([programId])
}

model GymProgramExercise {
  id      String        @id @default(uuid())
  dayId   String
  day     GymProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  name    String
  sets    Int           @default(3)
  reps    String        @default("10")  // string to allow "8-12" or "AMRAP"
  weight  String?       // e.g. "60kg" or "bodyweight"
  restSec Int           @default(60)
  order   Int           @default(0)
  notes   String?

  @@index([dayId])
}

model GymProgramAssignment {
  id        String     @id @default(uuid())
  programId String
  program   GymProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  traineeId String
  trainee   GymTrainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  startDate DateTime   @default(now())
  endDate   DateTime?
  isActive  Boolean    @default(true)
  notes     String?
  createdAt DateTime   @default(now())

  @@index([traineeId])
  @@index([programId])
}

// ─── Feature: Lockers ────────────────────────────────────────────────────────
model GymLocker {
  id          String                @id @default(uuid())
  number      String
  zone        String                @default("general")
  // general | men | women | vip
  notes       String?
  assignments GymLockerAssignment[]
  createdAt   DateTime              @default(now())

  @@unique([number, zone])
  @@index([zone])
}

model GymLockerAssignment {
  id        String     @id @default(uuid())
  lockerId  String
  locker    GymLocker  @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  traineeId String
  trainee   GymTrainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  startDate DateTime   @default(now())
  endDate   DateTime?
  isActive  Boolean    @default(true)
  notes     String?
  createdAt DateTime   @default(now())

  @@index([lockerId])
  @@index([traineeId])
}

// ─── Feature: Coach Shifts ──────────────────────────────────────────────────
model GymShift {
  id        String    @id @default(uuid())
  coachId   String
  coach     GymCoach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String    // "08:00"
  endTime   String    // "16:00"
  notes     String?
  createdAt DateTime  @default(now())

  @@index([coachId])
  @@index([date])
}
