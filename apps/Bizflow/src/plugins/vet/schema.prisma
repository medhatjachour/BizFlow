// Vet Plugin – Prisma Schema
// This file is merged into prisma/merged.prisma by scripts/merge-schemas.js
// Do NOT add a datasource or generator block here.

// ─── Owner ────────────────────────────────────────────────────────────────────
// A person who owns one or more pets registered in the vet clinic.

model VetOwner {
  id        String       @id @default(uuid())
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?
  patients  VetPatient[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([name])
  @@index([phone])
  @@index([createdAt])
}

// ─── Patient (Pet) ────────────────────────────────────────────────────────────

model VetPatient {
  id           String          @id @default(uuid())
  ownerId      String
  owner        VetOwner        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String          // Pet name
  species      String          // 'dog' | 'cat' | 'bird' | 'rabbit' | 'guinea_pig' | 'reptile' | 'fish' | 'other'
  breed        String?
  petColor     String?
  microchipId  String?         @unique
  dateOfBirth  DateTime?
  gender       String?         // 'male' | 'female' | 'unknown'
  weight       Float?          // kg – last recorded weight at registration
  allergies    String?
  medicalNotes String?
  sessions     VetSession[]
  appointments VetAppointment[]
  checkResults VetCheckResult[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([species])
  @@index([microchipId])
  @@index([createdAt])
}

// ─── Session (Vet Visit) ──────────────────────────────────────────────────────

model VetSession {
  id             String             @id @default(uuid())
  patientId      String
  patient        VetPatient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitDate      DateTime           @default(now())
  visitType      String             @default("wellness_exam") // 'wellness_exam' | 'vaccination' | 'surgery' | 'emergency' | 'follow_up' | 'grooming'
  vetName        String?
  chiefComplaint String
  // JSON: { weight_kg?, temp_rectal_c?, heart_rate?, resp_rate?, crt?, mucous_membranes? }
  vetVitals      String?
  diagnosis      String?
  notes          String?
  followUpDate   DateTime?
  status         String             @default("completed") // 'active' | 'completed' | 'cancelled'
  amountCharged  Float?
  amountPaid     Float?
  paymentStatus  String             @default("unpaid")   // 'paid' | 'partial' | 'unpaid' | 'waived'
  paymentMethod  String?            // 'cash' | 'card' | 'insurance' | 'other'
  prescriptions  VetPrescription[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([patientId])
  @@index([visitDate])
  @@index([status])
  @@index([paymentStatus])
}

// ─── Prescription ─────────────────────────────────────────────────────────────

model VetPrescription {
  id           String     @id @default(uuid())
  sessionId    String
  session      VetSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  medicineName String
  dosage       String?    // e.g. "10mg/kg"
  frequency    String?    // e.g. "2x daily"
  duration     String?    // e.g. "7 days"
  quantity     Int?
  instructions String?
  isActive     Boolean    @default(true)
  startDate    DateTime?
  stoppedAt    DateTime?
  stopReason   String?    // 'completed' | 'side_effects' | 'not_effective' | 'other'
  createdAt    DateTime   @default(now())

  @@index([sessionId])
  @@index([isActive])
}

// ─── Appointment ─────────────────────────────────────────────────────────────

model VetAppointment {
  id              String     @id @default(uuid())
  patientId       String
  patient         VetPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentDate DateTime
  duration        Int        @default(30) // minutes
  // 'consultation' | 'follow_up' | 'vaccination' | 'surgery' | 'grooming' | 'checkup'
  type            String     @default("consultation")
  vetName         String?
  notes           String?
  status          String     @default("scheduled") // 'scheduled' | 'confirmed' | 'completed' | 'cancelled' | 'no_show'
  reminderSent    Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([patientId])
  @@index([appointmentDate])
  @@index([status])
}

// ─── Check Result (Lab / Imaging) ─────────────────────────────────────────────

model VetCheckResult {
  id          String     @id @default(uuid())
  patientId   String
  patient     VetPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileName    String
  filePath    String
  fileSize    Int?
  resultDate  DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@index([patientId])
  @@index([resultDate])
}

// ─── Expense ──────────────────────────────────────────────────────────────────

model VetExpense {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  // 'rent' | 'utilities' | 'medical_supplies' | 'medications' | 'equipment' |
  // 'maintenance' | 'lab_fees' | 'insurance' | 'marketing' | 'cleaning' | 'salaries' | 'other'
  category      String
  description   String
  amount        Float
  vendor        String?
  paymentMethod String?  // 'cash' | 'card' | 'bank_transfer' | 'other'
  recurrence    String?  // 'one_time' | 'monthly' | 'quarterly' | 'yearly'
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([category])
}

// ─── Staff ────────────────────────────────────────────────────────────────────

model VetStaff {
  id             String           @id @default(uuid())
  name           String
  // 'veterinarian' | 'vet_tech' | 'receptionist' | 'groomer' | 'other'
  role           String
  phone          String
  email          String?
  employmentType String           @default("full_time") // 'full_time' | 'part_time' | 'contract'
  status         String           @default("active")    // 'active' | 'inactive'
  baseSalary     Float            @default(0)
  salaryType     String           @default("monthly")   // 'monthly' | 'hourly'
  hourlyRate     Float?
  overtimeRate   Float?
  hireDate       DateTime?
  salaryRecords  VetSalaryRecord[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([role])
}

// ─── Salary Record ────────────────────────────────────────────────────────────

model VetSalaryRecord {
  id               String   @id @default(uuid())
  staffId          String
  staff            VetStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month            Int      // 1–12
  year             Int
  baseSalary       Float    @default(0)
  regularHours     Float    @default(0)
  overtimeHours    Float    @default(0)
  overtimeMultiplier Float  @default(1.5)
  doubleShiftCount Int      @default(0)
  doubleShiftBonus Float    @default(0)
  bonuses          Float    @default(0)
  deductions       Float    @default(0)
  netPay           Float    @default(0)
  status           String   @default("draft") // 'draft' | 'confirmed' | 'paid'
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([staffId, month, year])
  @@index([staffId])
  @@index([year, month])
}

// ─── Medicine Catalogue ───────────────────────────────────────────────────────

model VetMedicine {
  id           String             @id @default(uuid())
  name         String
  // 'antibiotic' | 'antiparasitic' | 'vaccine' | 'anesthetic' | 'supplement' | 'general' | 'other'
  category     String             @default("general")
  // 'tablet' | 'capsule' | 'ml' | 'vial' | 'tube' | 'bottle' | 'sachet' | 'other'
  unit                 String             @default("tablet")  // container unit label
  // Unit conversion — optional. Enables selling by sub-unit (e.g. sell ml from a bottle).
  subUnit              String?            // e.g. 'ml', 'cc', 'mg'
  subUnitsPerContainer Float?             // e.g. 100 (100 ml per bottle)
  description  String?
  minimumStock Float              @default(0)
  batches      VetMedicineBatch[]
  sales        VetMedicineSale[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([name])
  @@index([category])
}

// ─── Medicine Batch (stock lot with expiry) ────────────────────────────────────

model VetMedicineBatch {
  id              String            @id @default(uuid())
  medicineId      String
  medicine        VetMedicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber     String?
  supplier        String?
  expiryDate      DateTime
  quantity        Float             // remaining stock
  initialQty      Float             // original received qty
  costPerUnit     Float             @default(0)
  sellingPrice    Float?            // intended selling price per unit (set at batch receipt)
  receivedDate    DateTime          @default(now())
  notes           String?
  // Disposal / write-off fields
  status          String            @default("active") // 'active' | 'disposed'
  disposedAt      DateTime?
  disposedQty     Float?            // qty written off (usually = quantity at disposal time)
  disposalReason  String?
  sales           VetMedicineSale[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([medicineId])
  @@index([expiryDate])
  @@index([status])
}

// ─── Medicine Sale ─────────────────────────────────────────────────────────────

model VetMedicineSale {
  id            String           @id @default(uuid())
  medicineId    String
  medicine      VetMedicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchId       String
  batch         VetMedicineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity      Float
  unitPrice     Float
  totalPrice    Float
  discount      Float            @default(0)
  // Groups all line items sold together in a single cart checkout (one receipt).
  // NULL for legacy single-item sales recorded before combined-sale support.
  saleGroupId   String?
  // Soft references — no FK so they work without strict FK constraints
  patientId     String?
  patientName   String?
  ownerId       String?          // Links to VetOwner (customer)
  ownerName     String?          // Denormalised for display without a join
  paymentMethod String?          // 'cash' | 'card' | 'insurance' | 'other'
  saleUnit      String?          // 'container' | 'sub' — which unit was used when selling
  amountPaid    Float?           // how much has been collected (NULL = fully paid at sale time)
  paymentStatus String?          @default("paid") // 'paid' | 'partial' | 'unpaid'
  // Refund / void tracking
  status        String?          @default("completed") // 'completed' | 'refunded' | 'partially_refunded'
  refundedQty   Float?           // units returned to stock on refund
  refundedAmount Float?          // money returned to the customer
  refundedAt    DateTime?
  refundReason  String?
  notes         String?
  saleDate      DateTime         @default(now())
  createdAt     DateTime         @default(now())

  @@index([medicineId])
  @@index([batchId])
  @@index([saleDate])
  @@index([patientId])
  @@index([ownerId])
  @@index([saleGroupId])
}

// ─── Medicine Category (user-managed catalogue taxonomy) ───────────────────────

model VetMedicineCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#8b5cf6")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ─── Medicine Unit (user-managed container units) ──────────────────────────────

model VetMedicineUnit {
  id        String   @id @default(uuid())
  name      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}
