// ─── Restaurant Module ──────────────────────────────────────────────────────
// Module: restaurant
// Use Case: Table management, reservations, menu, dine-in orders
//
// NOTE: Merged into prisma/merged.prisma at build time via merge-schemas.js
// ────────────────────────────────────────────────────────────────────────────

model RestaurantTable {
  id           String             @id @default(uuid())
  number       Int                @unique
  capacity     Int                @default(4)
  status       String             @default("available") // available | occupied | reserved | cleaning
  section      String?            // e.g. "Indoor", "Outdoor", "Bar"
  isActive     Boolean            @default(true)
  reservations TableReservation[]
  orders       DineInOrder[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([section])
}

model TableReservation {
  id            String          @id @default(uuid())
  tableId       String
  table         RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String?
  partySize     Int             @default(1)
  date          DateTime        // Date & time of reservation
  notes         String?
  status        String          @default("pending") // pending | confirmed | seated | completed | cancelled
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tableId])
  @@index([date])
  @@index([status])
}

model MenuItem {
  id              String            @id @default(uuid())
  name            String
  category        String            @default("Main")
  description     String?
  price           Float
  cost            Float             @default(0)
  preparationTime Int               @default(15) // minutes
  isAvailable     Boolean           @default(true)
  displayOrder    Int               @default(0)
  notes           String?
  orderItems      DineInOrderItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([category])
  @@index([isAvailable])
}

model DineInOrder {
  id         String            @id @default(uuid())
  tableId    String
  table      RestaurantTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status     String            @default("open") // open | ready | paid | voided
  serverName String?
  notes      String?
  subtotal   Float             @default(0)
  tax        Float             @default(0)
  total      Float             @default(0)
  openedAt   DateTime          @default(now())
  closedAt   DateTime?
  items      DineInOrderItem[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([tableId])
  @@index([status])
  @@index([openedAt])
}

model DineInOrderItem {
  id         String       @id @default(uuid())
  orderId    String
  order      DineInOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String       // Snapshot name
  quantity   Int          @default(1)
  unitPrice  Float
  notes      String?
  status     String       @default("pending") // pending | preparing | ready | served
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([orderId])
  @@index([menuItemId])
}
