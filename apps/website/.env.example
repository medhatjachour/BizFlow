# URL of the live BizFlow app that the Nebula "BizFlow" window embeds.
#
# Web port (recommended): BizFlow running as a real web app.
#   Start it from the repo root with:  npm run dev:web
NEXT_PUBLIC_BIZFLOW_URL=http://localhost:5180/

# Streaming alternative (Docker noVNC), if you use streaming/ instead:
# NEXT_PUBLIC_BIZFLOW_URL=http://localhost:6080/vnc.html?autoconnect=true&resize=remote&reconnect=true&path=websockify

# ─────────────────────────────────────────────────────────────────────────────
# Payments (Stripe) — see docs/STRIPE-SETUP.md
# Leave these unset to keep the site working with download links instead of
# checkout. Add them to enable real payments.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute origin of this site (used to build Stripe return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sign-In (optional). Create a Web application OAuth client in Google
# Cloud, then add https://your-domain/api/account/google as its redirect URI.
# GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe secret key (server only — NEVER prefix with NEXT_PUBLIC).
# STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret from `stripe listen` or the Dashboard.
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Website commerce/account DB (Prisma SQLite by default).
# In Docker we use: WEBSITE_DATABASE_URL=file:/data/bizflow/website.db
# WEBSITE_DATABASE_URL=file:./.data/website.db

# Optional: charge in a different currency (default: usd).
# STRIPE_CURRENCY=usd

# ─────────────────────────────────────────────────────────────────────────────
# Downloads & on-demand server builds (optional)
# Leave unset to link the public releases page. Set the base to serve installers
# directly; add the GITHUB_BUILD_* vars to build a missing installer on demand
# (via a GitHub Actions workflow) and download it when ready.
# ─────────────────────────────────────────────────────────────────────────────
# Direct artifact base, e.g. a GitHub "releases/latest/download" URL.
# NEXT_PUBLIC_DOWNLOAD_BASE=https://github.com/<owner>/<repo>/releases/latest/download
# Repo hosting the build workflow + releases, e.g. "owner/bizflow".
# GITHUB_BUILD_REPO=owner/bizflow
# Workflow file that builds an installer (accepts `module` + `os` inputs).
# GITHUB_BUILD_WORKFLOW=build-desktop.yml
# Git ref to build from (default: main).
# GITHUB_BUILD_REF=main
# Token with "actions: write" on the build repo (server-only, never NEXT_PUBLIC).
# GITHUB_BUILD_TOKEN=ghp_xxx

# Optional: use pre-created Stripe Price IDs instead of dynamic prices.
# STRIPE_PRICE_SUITE=price_xxx
# STRIPE_PRICE_COMMERCE=price_xxx
# STRIPE_PRICE_BAKERY=price_xxx
# STRIPE_PRICE_RESTAURANT=price_xxx
# STRIPE_PRICE_WAREHOUSE=price_xxx
# STRIPE_PRICE_CLINIC=price_xxx
# STRIPE_PRICE_VET=price_xxx
# STRIPE_PRICE_GYM=price_xxx

# ──────────────────────────────────────────────────────────────────────────────
# Analytics (optional, privacy-first & consent-gated). No script loads until the
# visitor accepts the consent banner. Leave unset to fully disable analytics.
# ──────────────────────────────────────────────────────────────────────────────
# Plausible (cookieless, GDPR-friendly) — set to your verified domain:
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=bizflow.app

# Google Analytics 4 — loads (with anonymize_ip) only after consent:
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ──────────────────────────────────────────────────────────────────────────────
# Transactional email (password reset + support tickets)
# Configure SMTP to enable account reset and support notifications.
# ──────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=mailer@your-domain.com
# SMTP_PASS=your_smtp_password

# Optional sender override for account/support transactional emails.
# ACCOUNT_MAIL_FROM=BizFlow <no-reply@your-domain.com>

# Optional support inbox override for internal support ticket notifications.
# SUPPORT_MAIL_TO=support@your-domain.com
